{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "credentialsSource": "local",
      "distribution": "internal",
      "android": { "buildType": "apk", "image": "latest" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vexo-cart-api.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_API_URL": "https://vexo-cart-api.onrender.com/api"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": { "buildType": "apk" },
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {}
  }
}
