SECRET_KEY=change-me-in-production
DEBUG=True
# Omit to allow all hosts in DEBUG (Expo Go on your phone). Or list your LAN IP.
# ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.10

# Default database is SQLite (backend/db.sqlite3). Render uses SQLITE_DB_PATH on a persistent disk.
USE_SQLITE=true
# SQLITE_DB_PATH=/var/data/db.sqlite3
# PostgreSQL (optional): USE_SQLITE=false and DATABASE_URL=postgres://...
# DATABASE_URL=postgres://...
USE_MYSQL=false
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MEDIA_URL=/media/
STATIC_URL=/static/

# --- Email (pick Resend OR Gmail SMTP) ---
# Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vexo Cart <onboarding@resend.dev>
EMAIL_OTP_EXPIRE_MINUTES=10

# Gmail SMTP alternative:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
# DEFAULT_FROM_EMAIL=Vexo Cart <your@gmail.com>

# Razorpay — https://dashboard.razorpay.com/app/keys (test keys only by default)
RAZORPAY_TEST_MODE_ONLY=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
